const fs = require('fs');
const jwt = require('jsonwebtoken');
require('dotenv').config(); // Load biến môi trường từ .env

const SECRET_KEY = process.env.JWT_SECRET || 'mysecretkey'; // Đảm bảo có SECRET_KEY

// Hàm tạo token và cập nhật vào file .env
const generateToken = () => {
    const token = jwt.sign({ userId: 1 }, SECRET_KEY, { expiresIn: '1m' }); // Token sống 1 phút

    // Đọc nội dung .env
    let envConfig = fs.readFileSync('.env', 'utf8').split('\n');

    // Kiểm tra nếu đã có dòng JWT_TOKEN thì cập nhật, nếu chưa thì thêm mới
    let updated = false;
    envConfig = envConfig.map(line => {
        if (line.startsWith('JWT_TOKEN=')) {
            updated = true;
            return `JWT_TOKEN=${token}`;
        }
        return line;
    });

    if (!updated) {
        envConfig.push(`JWT_TOKEN=${token}`);
    }

    // Ghi lại vào file .env
    fs.writeFileSync('.env', envConfig.join('\n'), 'utf8');

    console.log('Token mới đã được cập nhật vào .env:', token);
    return token;
};

// Gọi hàm để tạo token
generateToken();